+
+    fn accepts_callback(&self, input_context_id: u16) -> bool {
+        self.focus.accepts_callback(input_context_id)
+    }
+
+    fn apply_focus_actions<C: Client<XEvent = xproto::KeyPressEvent>>(
+        &mut self,
+        client: &mut C,
+        actions: Vec<ImeAction>,
+    ) -> Result<(), ClientError> {
+        let mut first_error = None;
+        for action in actions {
+            match action {
+                ImeAction::Create { window } => {
+                    self.window = window;
+                    let attrs = client
+                        .build_ic_attributes()
+                        .push(AttributeName::InputStyle, InputStyle::PREEDIT_CALLBACKS)
+                        .push(AttributeName::ClientWindow, window)
+                        .push(AttributeName::FocusWindow, window)
+                        .build();
+                    if let Err(error) = client.create_ic(self.im_id, attrs) {
+                        self.focus.ic = ImeIc::None;
+                        return Err(error);
+                    }
+                }
+                ImeAction::SetFocus { id } => {
+                    if let Err(error) = client.set_focus(self.im_id, id) {
+                        self.focus.set_focus_failed(id);
+                        first_error.get_or_insert(error);
+                    }
+                }
+                ImeAction::UnsetFocus { id } => {
+                    if let Err(error) = client.unset_focus(self.im_id, id) {
+                        first_error.get_or_insert(error);
+                    }
+                }
+                ImeAction::Reset { id } => {
+                    if let Err(error) = client.reset_ic(self.im_id, id) {
+                        first_error.get_or_insert(error);
+                    }
+                }
+                ImeAction::Destroy { id } => {
+                    if let Err(error) = client.destroy_ic(self.im_id, id) {
+                        first_error.get_or_insert(error);
+                    }
+                }
+            }
+        }
+        first_error.map_or(Ok(()), Err)
+    }
 }
 
