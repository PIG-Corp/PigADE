 use x11rb::protocol::{Event, xproto};
 use xim::{AHashMap, AttributeName, Client, ClientError, ClientHandler, InputStyle};
 
+// BEGIN PIGADE XIM FOCUS STATE
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ImeIc {
+    None,
+    Creating {
+        window: xproto::Window,
+    },
+    Ready {
+        id: u16,
+        window: xproto::Window,
+        focused: bool,
+    },
+    Destroying {
+        id: u16,
+    },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum ImeAction {
+    Create { window: xproto::Window },
+    SetFocus { id: u16 },
+    UnsetFocus { id: u16 },
+    Reset { id: u16 },
+    Destroy { id: u16 },
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+struct ImeFocusState {
+    ready: bool,
+    desired_window: Option<xproto::Window>,
+    ic: ImeIc,
+}
+
+impl ImeFocusState {
+    fn new() -> Self {
+        Self {
+            ready: false,
+            desired_window: None,
+            ic: ImeIc::None,
+        }
+    }
+    fn is_focused(&self, id: u16) -> bool {
+        matches!(self.ic, ImeIc::Ready { id: current, focused: true, .. } if current == id)
+    }
+    fn accepts_callback(&self, id: u16) -> bool {
+        self.is_focused(id)
+    }
+    fn set_focus_failed(&mut self, id: u16) {
+        if let ImeIc::Ready {
+            id: current,
+            window,
+            ..
+        } = self.ic
+        {
+            if current == id {
+                self.ic = ImeIc::Ready {
+                    id,
+                    window,
+                    focused: false,
+                };
+            }
+        }
+    }
+    fn ensure(&mut self) -> Vec<ImeAction> {
+        if self.ready && matches!(self.ic, ImeIc::None) {
+            if let Some(window) = self.desired_window.filter(|window| *window != 0) {
+                self.ic = ImeIc::Creating { window };
+                return vec![ImeAction::Create { window }];
+            }
+        }
+        Vec::new()
+    }
+    fn im_ready(&mut self) -> Vec<ImeAction> {
+        self.ready = true;
+        self.ensure()
+    }
+    fn focus_in(&mut self, window: xproto::Window) -> Vec<ImeAction> {
+        if window == 0 {
+            return Vec::new();
+        }
+        self.desired_window = Some(window);
+        match self.ic {
+            ImeIc::Ready {
+                id,
+                window: bound,
+                focused,
+            } if bound == window => {
+                if focused {
+                    Vec::new()
+                } else {
+                    self.ic = ImeIc::Ready {
+                        id,
+                        window,
+                        focused: true,
+                    };
+                    vec![ImeAction::SetFocus { id }]
+                }
+            }
+            ImeIc::Ready { id, focused, .. } => {
+                let mut actions = Vec::new();
+                if focused {
+                    actions.push(ImeAction::UnsetFocus { id });
+                    actions.push(ImeAction::Reset { id });
+                }
+                actions.push(ImeAction::Destroy { id });
+                self.ic = ImeIc::Destroying { id };
+                actions
+            }
+            ImeIc::None => self.ensure(),
+            ImeIc::Creating { .. } | ImeIc::Destroying { .. } => Vec::new(),
+        }
+    }
+    fn focus_out(&mut self, window: xproto::Window) -> Vec<ImeAction> {
+        if self.desired_window != Some(window) {
+            return Vec::new();
+        }
+        self.desired_window = None;
+        if let ImeIc::Ready {
+            id,
+            window: bound,
+            focused: true,
+        } = self.ic
+        {
+            if bound == window {
+                self.ic = ImeIc::Ready {
+                    id,
+                    window: bound,
+                    focused: false,
+                };
+                return vec![ImeAction::UnsetFocus { id }, ImeAction::Reset { id }];
+            }
+        }
+        Vec::new()
+    }
+    fn create_reply(&mut self, id: u16) -> Vec<ImeAction> {
+        let ImeIc::Creating { window } = self.ic else {
+            return vec![ImeAction::Destroy { id }];
+        };
+        self.ic = ImeIc::Ready {
+            id,
+            window,
+            focused: false,
+        };
+        if self.desired_window == Some(window) {
+            self.ic = ImeIc::Ready {
+                id,
+                window,
+                focused: true,
+            };
+            vec![ImeAction::SetFocus { id }]
+        } else {
+            self.ic = ImeIc::Destroying { id };
+            vec![ImeAction::Destroy { id }]
+        }
+    }
+    fn destroy_reply(&mut self, id: u16) -> Vec<ImeAction> {
+        if self.ic == (ImeIc::Destroying { id }) {
+            self.ic = ImeIc::None;
+            self.ensure()
+        } else {
+            Vec::new()
+        }
+    }
+}
+// END PIGADE XIM FOCUS STATE
+
+// BEGIN PIGADE XIM FOCUS TESTS
+#[cfg(test)]
+mod pigade_focus_tests {
+    use super::{ImeAction as A, ImeFocusState as S};
+
+    #[test]
+    fn focus_before_ready_creates_only_after_im_ready_and_repeated_focus_is_idempotent() {
+        let mut s = S::new();
+        assert_eq!(s.focus_in(11), vec![]);
+        assert_eq!(s.im_ready(), vec![A::Create { window: 11 }]);
+        assert_eq!(s.focus_in(11), vec![]);
+        assert_eq!(s.create_reply(7), vec![A::SetFocus { id: 7 }]);
+        assert!(s.is_focused(7));
+    }
+
+    #[test]
+    fn zero_window_never_creates_an_input_context() {
+        let mut s = S::new();
+        assert_eq!(s.im_ready(), vec![]);
+        assert_eq!(s.focus_in(0), vec![]);
+        assert_eq!(s.focus_out(0), vec![]);
+        assert!(!s.is_focused(0));
+    }
+
+    #[test]
+    fn create_reply_after_blur_is_destroyed_without_stale_focus() {
+        let mut s = S::new();
+        assert_eq!(s.im_ready(), vec![]);
+        assert_eq!(s.focus_in(11), vec![A::Create { window: 11 }]);
+        assert_eq!(s.focus_out(11), vec![]);
+        assert_eq!(s.create_reply(7), vec![A::Destroy { id: 7 }]);
+        assert!(!s.is_focused(7));
+    }
+
+    #[test]
+    fn window_switch_while_create_pending_waits_for_destroy_before_new_create() {
+        let mut s = S::new();
+        s.im_ready();
+        assert_eq!(s.focus_in(11), vec![A::Create { window: 11 }]);
+        assert_eq!(s.focus_in(22), vec![]);
+        assert_eq!(s.create_reply(7), vec![A::Destroy { id: 7 }]);
+        assert_eq!(s.destroy_reply(7), vec![A::Create { window: 22 }]);
+        assert_eq!(s.create_reply(8), vec![A::SetFocus { id: 8 }]);
+        assert!(s.is_focused(8));
+        assert!(!s.is_focused(7));
+    }
+
+    #[test]
+    fn refocus_reuses_same_ic_and_focus_out_unsets_before_reset() {
+        let mut s = S::new();
+        s.im_ready();
+        assert_eq!(s.focus_in(11), vec![A::Create { window: 11 }]);
+        assert_eq!(s.create_reply(7), vec![A::SetFocus { id: 7 }]);
+        assert_eq!(
+            s.focus_out(11),
+            vec![A::UnsetFocus { id: 7 }, A::Reset { id: 7 }]
+        );
+        assert_eq!(s.focus_in(11), vec![A::SetFocus { id: 7 }]);
+        assert_eq!(s.focus_in(11), vec![]);
+    }
+
+    #[test]
+    fn focus_change_from_ready_ic_never_reuses_old_window_context() {
+        let mut s = S::new();
+        s.im_ready();
+        s.focus_in(11);
+        s.create_reply(7);
+        assert_eq!(
+            s.focus_in(22),
+            vec![
+                A::UnsetFocus { id: 7 },
+                A::Reset { id: 7 },
+                A::Destroy { id: 7 }
+            ]
+        );
+        assert_eq!(s.destroy_reply(7), vec![A::Create { window: 22 }]);
+        assert_eq!(s.create_reply(8), vec![A::SetFocus { id: 8 }]);
+    }
+
+    #[test]
+    fn stale_or_unexpected_ic_ids_are_not_callback_eligible() {
+        let mut s = S::new();
+        s.im_ready();
+        s.focus_in(11);
+        assert!(!s.accepts_callback(7));
+        s.create_reply(7);
+        assert!(s.accepts_callback(7));
+        assert!(!s.accepts_callback(8));
+        s.focus_in(22);
+        assert!(!s.accepts_callback(7));
+        assert!(!s.accepts_callback(8));
+    }
+
+    #[test]
+    fn failed_set_focus_invalidates_local_focus_and_repeat_focus_out_is_noop() {
+        let mut s = S::new();
+        s.im_ready();
+        s.focus_in(11);
+        s.create_reply(7);
+        assert!(s.is_focused(7));
+        s.set_focus_failed(7);
+        assert!(!s.is_focused(7));
+        assert_eq!(s.focus_out(11), vec![]);
+        assert_eq!(s.focus_out(11), vec![]);
+    }
+
+    #[test]
+    fn repeated_focus_out_does_not_duplicate_unset_or_reset() {
+        let mut s = S::new();
+        s.im_ready();
+        s.focus_in(11);
+        s.create_reply(7);
+        assert_eq!(
+            s.focus_out(11),
+            vec![A::UnsetFocus { id: 7 }, A::Reset { id: 7 }]
+        );
+        assert_eq!(s.focus_out(11), vec![]);
+    }
+}
+// END PIGADE XIM FOCUS TESTS
