+        self.apply_focus_actions(client, actions)
+    }
+
+    pub(super) fn focus_out<C: Client<XEvent = xproto::KeyPressEvent>>(
+        &mut self,
+        client: &mut C,
+        window: xproto::Window,
+    ) -> Result<(), ClientError> {
