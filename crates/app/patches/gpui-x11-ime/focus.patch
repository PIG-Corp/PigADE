+
+    #[test]
+    fn unsupported_callback_style_never_creates_an_input_context() {
+        let mut s = S::new();
+        assert_eq!(s.focus_in(11), vec![]);
+        assert_eq!(s.im_ready(false), vec![]);
+        assert_eq!(s.focus_in(11), vec![]);
+    }
+
+    #[test]
+    fn callback_style_must_be_exact_composite() {
+        assert!(supports_callback_preedit_style([2 | 1024]));
+        assert!(!supports_callback_preedit_style([2]));
+        assert!(!supports_callback_preedit_style([1024]));
+        assert!(!supports_callback_preedit_style([1 | 1024]));
+        assert!(!supports_callback_preedit_style([2 | 1024 | 4]));
+    }
+
+    #[test]
+    fn input_style_payload_shape_rejects_bad_header_length_and_trailing_bytes() {
+        assert!(input_style_payload_shape_valid(&[1, 0, 0, 0, 2, 4, 0, 0]));
+        assert!(input_style_payload_shape_valid(&[0, 0, 0, 0]));
+        assert!(!input_style_payload_shape_valid(&[]));
+        assert!(!input_style_payload_shape_valid(&[1, 0, 0, 0]));
+        // Protocol padding is unspecified and ignored by the typed decoder.
+        assert!(input_style_payload_shape_valid(&[0, 0, 1, 0]));
+        assert!(input_style_payload_shape_valid(&[1, 0, 255, 127, 2, 4, 0, 0]));
+        assert!(!input_style_payload_shape_valid(&[0, 0, 0, 0, 0]));
+    }
+
+    #[test]
+    fn focus_before_ready_creates_only_after_im_ready_and_repeated_focus_is_idempotent() {
+        let mut s = S::new();
+        assert_eq!(s.focus_in(11), vec![]);
+        assert_eq!(s.im_ready(true), vec![A::Create { window: 11 }]);
+        assert_eq!(s.focus_in(11), vec![]);
+        assert_eq!(s.create_reply(7), vec![A::SetFocus { id: 7 }]);
+        assert!(s.is_focused(7));
+    }
+
+    #[test]
+    fn zero_window_never_creates_an_input_context() {
+        let mut s = S::new();
+        assert_eq!(s.im_ready(true), vec![]);
+        assert_eq!(s.focus_in(0), vec![]);
+        assert_eq!(s.focus_out(0), vec![]);
+        assert!(!s.is_focused(0));
+    }
+
+    #[test]
+    fn create_reply_after_blur_is_destroyed_without_stale_focus() {
+        let mut s = S::new();
+        assert_eq!(s.im_ready(true), vec![]);
+        assert_eq!(s.focus_in(11), vec![A::Create { window: 11 }]);
+        assert_eq!(s.focus_out(11), vec![]);
+        assert_eq!(s.create_reply(7), vec![A::Destroy { id: 7 }]);
+        assert!(!s.is_focused(7));
+    }
+
+    #[test]
+    fn window_switch_while_create_pending_waits_for_destroy_before_new_create() {
+        let mut s = S::new();
+        s.im_ready(true);
+        assert_eq!(s.focus_in(11), vec![A::Create { window: 11 }]);
+        assert_eq!(s.focus_in(22), vec![]);
+        assert_eq!(s.create_reply(7), vec![A::Destroy { id: 7 }]);
+        assert_eq!(s.destroy_reply(7), vec![A::Create { window: 22 }]);
+        assert_eq!(s.create_reply(8), vec![A::SetFocus { id: 8 }]);
+        assert!(s.is_focused(8));
+        assert!(!s.is_focused(7));
+    }
+
+    #[test]
+    fn refocus_reuses_same_ic_and_focus_out_unsets_before_reset() {
+        let mut s = S::new();
+        s.im_ready(true);
+        assert_eq!(s.focus_in(11), vec![A::Create { window: 11 }]);
+        assert_eq!(s.create_reply(7), vec![A::SetFocus { id: 7 }]);
+        assert_eq!(
+            s.focus_out(11),
+            vec![A::UnsetFocus { id: 7 }, A::Reset { id: 7 }]
+        );
+        assert_eq!(s.focus_in(11), vec![A::SetFocus { id: 7 }]);
+        assert_eq!(s.focus_in(11), vec![]);
+    }
+
+    #[test]
+    fn focus_change_from_ready_ic_never_reuses_old_window_context() {
+        let mut s = S::new();
+        s.im_ready(true);
+        s.focus_in(11);
+        s.create_reply(7);
+        assert_eq!(
+            s.focus_in(22),
+            vec![
+                A::UnsetFocus { id: 7 },
+                A::Reset { id: 7 },
+                A::Destroy { id: 7 }
+            ]
+        );
+        assert_eq!(s.destroy_reply(7), vec![A::Create { window: 22 }]);
+        assert_eq!(s.create_reply(8), vec![A::SetFocus { id: 8 }]);
+    }
+
+    #[test]
+    fn stale_or_unexpected_ic_ids_are_not_callback_eligible() {
+        let mut s = S::new();
+        s.im_ready(true);
+        s.focus_in(11);
+        assert!(!s.accepts_callback(7));
+        s.create_reply(7);
+        assert!(s.accepts_callback(7));
+        assert!(!s.accepts_callback(8));
+        s.focus_in(22);
+        assert!(!s.accepts_callback(7));
+        assert!(!s.accepts_callback(8));
+    }
+
+    #[test]
+    fn failed_set_focus_invalidates_local_focus_and_repeat_focus_out_is_noop() {
+        let mut s = S::new();
+        s.im_ready(true);
+        s.focus_in(11);
+        s.create_reply(7);
+        assert!(s.is_focused(7));
+        s.set_focus_failed(7);
+        assert!(!s.is_focused(7));
+        assert_eq!(s.focus_out(11), vec![]);
+        assert_eq!(s.focus_out(11), vec![]);
+    }
+
+    #[test]
+    fn repeated_focus_out_does_not_duplicate_unset_or_reset() {
+        let mut s = S::new();
+        s.im_ready(true);
+        s.focus_in(11);
+        s.create_reply(7);
+        assert_eq!(
+            s.focus_out(11),
+            vec![A::UnsetFocus { id: 7 }, A::Reset { id: 7 }]
+        );
+        assert_eq!(s.focus_out(11), vec![]);
+    }
+}
