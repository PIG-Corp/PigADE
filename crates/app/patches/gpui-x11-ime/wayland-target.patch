+
+fn text_input_callback_matches<S: PartialEq, P: PartialEq>(
+    active: Option<(u64, &S, &P)>,
+    callback: Option<(u64, &S, &P)>,
+    focused_surface: Option<&S>,
+    require_focus: bool,
+) -> bool {
+    let (
+        Some((active_epoch, active_surface, active_proxy)),
+        Some((callback_epoch, callback_surface, callback_proxy)),
+    ) = (active, callback)
+    else {
+        return false;
+    };
+    active_epoch == callback_epoch
+        && active_surface == callback_surface
+        && active_proxy == callback_proxy
+        && (!require_focus || focused_surface.is_some_and(|focused| active_surface == focused))
+}
+
+fn done_serial_matches(commit_count: u32, serial: u32) -> bool {
+    commit_count == serial
+}
+
+#[derive(Clone, Copy, Debug, PartialEq, Eq)]
+enum TargetRequestDecision {
+    Idempotent,
+    Replace,
+    Reject,
+}
+
+fn target_request_decision<S: PartialEq>(
+    last_epoch: u64,
+    current: Option<(u64, &S)>,
+    requested_epoch: u64,
+    requested_surface: &S,
+) -> TargetRequestDecision {
+    if let Some((epoch, surface)) = current {
+        if requested_epoch == epoch && requested_surface == surface {
+            return TargetRequestDecision::Idempotent;
+        }
+    }
+    if requested_epoch == 0 || requested_epoch == u64::MAX || requested_epoch <= last_epoch {
+        TargetRequestDecision::Reject
+    } else {
+        TargetRequestDecision::Replace
+    }
+}
